{
  "name": "nexora",
  "version": "2.0.4",
  "description": "Nexora — personal finance: spending, budgets, investments, salary and goals.",
  "main": "main.js",
  "author": "Pedro",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build-win": "electron-builder --win portable",
    "build-mac": "electron-builder --mac && rm -rf dist/mac dist/mac-arm64",
    "update": "npm run build-mac && node deploy.js",
    "build-linux": "electron-builder --linux",
    "release": "electron-builder --mac --win --linux --publish always && find dist -mindepth 1 -maxdepth 1 ! -name .metadata_never_index ! -name '.icon-*' -exec rm -rf {} +"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "electron-updater": "^6.8.3",
    "pdf-parse": "^2.4.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.pedro.nexora",
    "productName": "Nexora",
    "files": [
      "main.js",
      "updater-mac.js",
      "carry-over.js",
      "css/**",
      "preload.js",
      "index.html",
      "js/**",
      "icon.png",
      "header-icon.png"
    ],
    "publish": {
      "provider": "github",
      "owner": "M4rt1n3z18",
      "repo": "Nexora-finance",
      "releaseType": "release"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "icon.png",
      "category": "public.app-category.finance"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Finance"
    },
    "nsis": {
      "oneClick": true,
      "deleteAppDataOnUninstall": false,
      "guid": "f1d542f1-83ce-5590-a9e0-ce3074a817fe"
    },
    "portable": {
      "artifactName": "Nexora.exe"
    }
  }
}
